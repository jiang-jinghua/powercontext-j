# ===== MiniMax（赛题必须：参与代码修改与调试）=====
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 当前账户可用模型：MiniMax-M3 / MiniMax-M3.1-Flash（M2 系列已下线，会返回 404）
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TEMPERATURE=0.2
MINIMAX_MAX_TOKENS=8192
# minimax = 真实调用；recorded = 回放归档响应（无 Key 时的可复现演示）
CTX_PROVIDER=minimax

# ===== seekdb / OceanBase（赛题必须：工程资料存储与全文检索）=====
# auto: 优先 seekdb，连不上才退化为本地 FTS5（仅用于离线自测）
CTX_STORE_BACKEND=auto
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DB=ctx

# ===== PowerContext（赛题必须：任务状态保存与跨会话复用）=====
CTX_STATE_BACKEND=powercontext
POWERCONTEXT_URL=http://127.0.0.1:8077
# 留空则自动取服务器上的首个 Scope（Default）
POWERCONTEXT_SCOPE=
POWERCONTEXT_TOKEN=
