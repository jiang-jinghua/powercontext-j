+    raw = diff_text.replace("\r\n", "\n").split("\n")
+    # 围栏与 Aider 标记（*** Begin Patch / *** Update File: / *** End Patch）都不是补丁内容
+    lines = [ln for ln in raw if not ln.startswith("```") and not ln.startswith("*** ")]
+    if len(lines) != len(raw):
