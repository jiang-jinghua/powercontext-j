+    # 末尾空行不是 hunk 内容，留着会被当成一个上下文行，把行数算多 1
+    trailing = 0
+    while lines and lines[-1] == "":
+        lines.pop()
+        trailing += 1
+    if trailing:
+        notes.append("清理末尾空行")
+
+    out: list[str] = []
+    idx = 0
+    while idx < len(lines):
+        line = lines[idx]
+        match = _HUNK_RE.match(line)
+        if not match:
+            out.append(line)
+            idx += 1
+            continue
+        old_start, new_start, suffix = match.group(1), match.group(3), match.group(5)
+        body: list[str] = []
+        idx += 1
