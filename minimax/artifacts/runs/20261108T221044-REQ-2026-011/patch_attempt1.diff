+
+
+class RefundAmountError(SettlementError):
+    """退款金额计算得到不合法的负值。"""
+
+    code = "E_REFUND_AMOUNT"
+
+
+class NegativeAllocationError(RefundAmountError):
+    """分摊后行实付金额为负。"""
+
+    code = "E_NEG_ALLOC"
+
+
+class NegativeRefundError(RefundAmountError):
+    """退款明细金额为负。"""
+
+    code = "E_NEG_REFUND"
