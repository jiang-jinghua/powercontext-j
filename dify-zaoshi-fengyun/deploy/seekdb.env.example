# OceanBase × Dify 一体化环境变量（追加/修改到 dify/docker/.env）

# 依据 OceanBase 官方教程《Dify x OceanBase seekdb 使用指南》
# https://open.oceanbase.com/blog/24132895248
# 要求：Dify >= 1.10.1（该版本起官方支持 MySQL 元数据库）

# ---------- 方案 3（推荐）：seekdb 同时作为元数据库 + 向量库 ----------
DB_TYPE=mysql
DB_USERNAME=root
DB_HOST=seekdb
DB_PORT=2881
DB_DATABASE=test

VECTOR_STORE=oceanbase
OCEANBASE_VECTOR_HOST=seekdb
OCEANBASE_VECTOR_USER=root

COMPOSE_PROFILES=seekdb

# ---------- 方案 2（退一档）：仅把 seekdb 当向量库，保留 PG 元数据库 ----------
#VECTOR_STORE=oceanbase
#OCEANBASE_VECTOR_HOST=seekdb
#OCEANBASE_VECTOR_USER=root
#COMPOSE_PROFILES=seekdb,postgresql
